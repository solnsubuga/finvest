# Placeholder values for local development only. Never put a real credential in this file.
# Each process connects as its own role: the API as finvest_app, the worker and scheduler as
# finvest_worker, and migrations as finvest_migrator. See db/init-roles.sql.
FINVEST_DATABASE_URL=postgresql+asyncpg://finvest_app:local-app-password@localhost:5432/finvest
# TLS to the database is verified by default. The local database has no certificate.
FINVEST_DATABASE_SSL_MODE=disable
FINVEST_API_DOCS=true
FINVEST_LOG_FORMAT=console
# Browser origins allowed to call the API, as JSON lists of exact origins.
FINVEST_CLIENT_ALLOWED_ORIGINS=["http://localhost:8081"]
FINVEST_STAFF_ALLOWED_ORIGINS=["http://localhost:5174"]
# Session cookies are Secure by default. Local development runs over plain http.
FINVEST_COOKIE_SECURE=false
# Passkeys work on localhost without TLS.
FINVEST_CLIENT_PASSKEY_SITE=localhost
FINVEST_STAFF_PASSKEY_SITE=localhost
# Staff authenticator apps need a key. Make your own, and never commit one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FINVEST_AUTHENTICATOR_KEY=
# Email is sent by the worker through Resend. Leave the backend as none to send nothing locally.
FINVEST_EMAIL_BACKEND=none
FINVEST_EMAIL_FROM=
FINVEST_EMAIL_RESEND_API_KEY=
# The tag the hooks.fidiba.com router sends Resend's delivery events back by. app_finvest_prod in
# production. Leave empty locally.
FINVEST_EMAIL_FIDIBA_ENVIRONMENT=
# The router's whsec_ secret for POST /webhooks/resend, read by the API. Empty turns the route off.
RESEND_HOOK_SECRET=
# Text messages. none sends nothing. local-console prints the number and the code to the worker's
# output, so it refuses to start when FINVEST_ENVIRONMENT is set to anything but local.
FINVEST_SMS_BACKEND=none
