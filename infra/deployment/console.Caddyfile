# Serves the built console inside its own container. The edge Caddy in front adds TLS and the
# security headers (infra/deployment/Caddyfile).
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip
	handle /health/live {
		respond "ok" 200
	}
	# Hashed file names never change, so they can be cached for a year.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Every other path is a route of the single page app.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
