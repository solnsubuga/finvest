# The edge, ported from Fidiba's infra/deployment/Caddyfile. Every request arrives through
# Cloudflare's proxy (the DigitalOcean firewall admits nothing else on 80 and 443), and Cloudflare
# connects with Full (strict) TLS against the Origin CA certificate that Terraform made.
{
	# The certificate comes from Cloudflare, not from ACME.
	auto_https disable_certs
	# Believe Cloudflare's visitor address header only from Cloudflare's own ranges
	# (https://www.cloudflare.com/ips/, checked 2026-11-13).
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

import /etc/caddy/upstreams.caddy

(origin_tls) {
	tls /etc/caddy-tls/origin.pem /etc/caddy-tls/origin.key
}

# While a deployment stops the previous release for a migration it cannot run beside, say so and
# ask clients to retry.
(updating) {
	handle_errors 502 {
		header Retry-After 30
		respond "Finvest is being updated. Please try again in a minute." 503
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}

# Every host but the client app, which needs the camera, turns the device features off.
(common_headers) {
	import security_headers
	header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
}

# Search engines list only the production website. Every other address asks to be left out.
(unlisted) {
	header X-Robots-Tag "noindex, nofollow"
}

(private_paths) {
	@private path_regexp private (?i)(^|/)(\.env[^/]*|\.git)(/|$)|\.(php|bak|old|save|sql|log)$
	respond @private 404
}

{$FINVEST_API_DOMAIN} {
	import origin_tls
	import updating
	import common_headers
	import unlisted
	encode zstd gzip
	# The API refuses bodies over 256 KiB itself, and over the limits in BODY_LIMITS
	# (backend/app/api/hardening.py) on the routes that take a file. Caddy stops anything far
	# larger before it reaches a container, with 413: by its declared length before anything is
	# forwarded, and by counting a body sent without one. Upload routes get 12 MiB here, above
	# every file route's own limit (10 MiB files plus the form around them); everything else
	# gets a million bytes. A new upload route is added to all four lists below.
	@upload path_regexp upload ^/(client/investments/[^/]+/payments/bank-transfer|client/payout-destinations/[^/]+/proof|client/identity-check/photos|client/identity-check/poses|client/claim-check/photos|staff/reconciliation/statements)(/|$)
	@other not path_regexp other ^/(client/investments/[^/]+/payments/bank-transfer|client/payout-destinations/[^/]+/proof|client/identity-check/photos|client/identity-check/poses|client/claim-check/photos|staff/reconciliation/statements)(/|$)
	@oversize {
		not path_regexp oversize ^/(client/investments/[^/]+/payments/bank-transfer|client/payout-destinations/[^/]+/proof|client/identity-check/photos|client/identity-check/poses|client/claim-check/photos|staff/reconciliation/statements)(/|$)
		header_regexp Content-Length ^[1-9][0-9]{6,}$
	}
	@upload_oversize {
		path_regexp upload_oversize ^/(client/investments/[^/]+/payments/bank-transfer|client/payout-destinations/[^/]+/proof|client/identity-check/photos|client/identity-check/poses|client/claim-check/photos|staff/reconciliation/statements)(/|$)
		expression `{header.Content-Length} != "" && int({header.Content-Length}) > 12582912`
	}
	request_body @upload {
		max_size 12MiB
	}
	request_body @other {
		max_size 1MB
	}
	# The API answers JSON only, so nothing it returns may run script or be framed.
	header ?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	route {
		respond @oversize 413
		respond @upload_oversize 413
		import private_paths
		import api_upstream
	}
}

{$FINVEST_ADMIN_DOMAIN} {
	import origin_tls
	import updating
	import common_headers
	import unlisted
	encode zstd gzip
	# Scripts and styles come from this origin; Cloudflare Web Analytics, which Cloudflare may add
	# to the pages it serves, reports to cloudflareinsights.com. Data comes only from the API.
	# Uploaded files (receipts, identity photos) open from the private bucket through short-lived
	# read links, as images or in a frame.
	header ?Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: {$FINVEST_STORAGE_ORIGIN}; frame-src {$FINVEST_STORAGE_ORIGIN}; object-src 'none'; font-src 'self' data:; connect-src 'self' https://{$FINVEST_API_DOMAIN} https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	route {
		import private_paths
		import console_upstream
	}
}

# The client app's web build (app.Dockerfile). The app image sends the policy written for its
# own build (app-csp.mjs): it allows the selfie's WebAssembly face detector and Regula's liveness
# check. Unlike the shared headers, the camera is allowed for this origin, for the ID photos and
# the guided selfie. The page itself takes no uploads (files go to the API host), so bodies stay
# small here.
{$FINVEST_APP_DOMAIN} {
	import origin_tls
	import updating
	import security_headers
	import unlisted
	header Permissions-Policy "accelerometer=(), camera=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	# Applies only if a response arrives without the image's own policy.
	header ?Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	route {
		import private_paths
		import app_upstream
	}
}

# The public website: generated per environment (site.caddy).
import /etc/caddy/site.caddy

:80, :443 {
	abort
}
