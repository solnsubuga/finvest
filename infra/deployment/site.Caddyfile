# Serves the built website inside its own container. The edge Caddy in front adds TLS and the
# other security headers (infra/deployment/Caddyfile).
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip
	# Written at build time for exactly the pages in this image (site-csp.mjs).
	import /etc/caddy/csp.caddy
	handle /health/live {
		respond "ok" 200
	}
	# Hashed file names never change, so they can be cached for a year.
	@hashed {
		path /_astro/*
		file
	}
	handle @hashed {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Pages are a folder each (/products/index.html) and change with every release.
	handle {
		header Cache-Control "public, max-age=300"
		try_files {path} {path}/index.html
		file_server
	}
	handle_errors {
		header Cache-Control "no-cache"
		@missing expression {err.status_code} == 404
		handle @missing {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		handle {
			respond "{err.status_code} {err.status_text}"
		}
	}
}
