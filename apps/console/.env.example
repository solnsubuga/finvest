# Copy to .env.local for local work. Never put a real secret in a VITE_ variable:
# everything with that prefix is shipped to the browser.

# Use the built-in sample staff in place of the backend. On by default under
# `pnpm dev`. Leave unset in any deployed build.
VITE_STUB_API=true

# Set by the deploy to "staging" or "production". A build fails if this is
# "production" while VITE_STUB_API is "true".
# VITE_DEPLOY_ENV=staging
