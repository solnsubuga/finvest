---
import { icons, type IconName } from "../lib/icons.ts";

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 22 } = Astro.props;
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={icons[name]}
/>
