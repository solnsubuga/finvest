---
import { company } from "../data/company.ts";
import Logo from "./Logo.astro";

const groups = [
  {
    title: "Invest",
    links: [
      { href: "/products", label: "Treasury bills" },
      { href: "/products", label: "Dollar fixed income" },
      { href: "/#goals", label: "Goals" },
      { href: "/how-it-works#accounts", label: "Group and company accounts" },
    ],
  },
  {
    title: "Finvest",
    links: [
      { href: "/about", label: "About us" },
      { href: "/safety", label: "Safety" },
      { href: "/about#contact", label: "Contact" },
    ],
  },
  {
    title: "Help",
    links: [
      { href: "/help", label: "Help centre" },
      { href: "/help#complaints", label: "Make a complaint" },
      { href: "/help#existing-clients", label: "Already a client? Claim your account" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/legal/terms", label: "Terms" },
      { href: "/legal/privacy", label: "Privacy" },
      { href: "/legal/risk", label: "Risk disclosure" },
      { href: "/legal/cookies", label: "Cookies" },
    ],
  },
];
const year = new Date().getUTCFullYear();

// Shown only once Finvest has supplied the facts (src/data/company.ts).
const legalLine = [
  company.registeredName && `Finvest is a trading name of ${company.registeredName}.`,
  company.regulator &&
    `Regulated by ${company.regulator}${company.licenceNumber ? ` under licence ${company.licenceNumber}` : ""}.`,
  company.officeAddress && `${company.officeAddress}, ${company.city}.`,
]
  .filter(Boolean)
  .join(" ");
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__about">
        <a class="brand" href="/" aria-label="Finvest home"><Logo /><span>finvest</span></a>
        <p>Treasury bills and fixed income for everyone in Uganda, from your phone.</p>
      </div>
      <div class="footer__links">
        {
          groups.map((group) => (
            <nav aria-label={group.title}>
              <h2>{group.title}</h2>
              <ul>
                {group.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>
    <div class="footer__small">
      {legalLine && <p>{legalLine}</p>}
      <p>
        Rates shown are yearly and after tax, and they change with each auction. The value of
        investments can go down as well as up. Withdrawing before maturity can return less than
        you put in.
      </p>
      <p>© {year} Finvest. All rights reserved.</p>
    </div>
  </div>
</footer>
