---
import ContactForm from "../components/ContactForm.astro";
import Icon from "../components/Icon.astro";
import IconCard from "../components/IconCard.astro";
import PageTitle from "../components/PageTitle.astro";
import { supportEmail } from "../config.ts";
import { company } from "../data/company.ts";
import { fallback } from "../data/fallback.ts";
import { minimumLabel } from "../lib/format.ts";
import Base from "../layouts/Base.astro";

// Figures that are true of the product today. Company figures (clients, money invested)
// belong here once Finvest publishes them.
const live = fallback.products.filter((product) => product.status === "live");
const shortest = live.reduce((a, b) => ((a.termDays ?? Infinity) <= (b.termDays ?? Infinity) ? a : b));
const smallest = live.reduce((a, b) => (a.minimumMinor <= b.minimumMinor ? a : b));

const figures = [
  { figure: `${shortest.termDays} days`, label: "Shortest term" },
  { figure: minimumLabel(smallest), label: "Smallest investment" },
  { figure: "Daily", label: "Interest shown in the app" },
  { figure: "8am to 8pm", label: "Chat support, every day" },
];

const beliefs = [
  {
    icon: "eye",
    title: "Show the real number",
    text: "Returns after tax, fees up front, and the exact amount you get back before you pay.",
  },
  {
    icon: "bolt",
    title: "Respect people's time",
    text: "No branch visits and no forms to print. Staff step in only when something needs a person.",
  },
  {
    icon: "shield",
    title: "Boring where it matters",
    text: "Government bills, a custodian bank, and books that are checked every single day.",
  },
] as const;

---

<Base
  title="About and contact"
  description="About Finvest: why we make Uganda government treasury bills easy to buy in small amounts from any phone, the rules we work by, and how to contact us."
>
  <PageTitle
    eyebrow="About"
    title="Government bills used to be for banks and big investors. Not any more."
    lead="Finvest makes Uganda's safest investments easy to buy in small amounts, from any phone."
  />

  <section class="band" id="story">
    <div class="wrap pair pair--loose">
      <div>
        <p class="eyebrow">Our story</p>
        <h2 class="h2 h2--small">Why we built Finvest</h2>
        <p class="lead">
          Treasury bills are how the Government of Uganda borrows, and they have long been one of
          the steadiest places to keep money. But buying one meant a bank visit, forms and
          waiting, so most people never did.
        </p>
        <p class="lead">
          Finvest was built in Kampala to change that. You open an account on your phone, pay by
          mobile money or bank transfer, and see the exact amount you will get back before you
          pay.
        </p>
        <p class="lead">
          We keep it plain on purpose: real government bills, returns shown after tax, and money
          paid straight to an account in your own name.
        </p>
      </div>
      <dl class="figures">
        {
          figures.map((item) => (
            <div>
              <dd>{item.figure}</dd>
              <dt>{item.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="band band--white" id="beliefs">
    <div class="wrap">
      <p class="eyebrow">What we believe</p>
      <h2 class="h2 h2--small">Three rules we work by.</h2>
      <div class="grid grid--3">
        {beliefs.map((belief) => <IconCard {...belief} />)}
      </div>
    </div>
  </section>

  <section class="band band--black" id="contact">
    <div class="wrap split split--form">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 class="h2">Talk to us.</h2>
        <p class="lead">
          Already a client? The fastest way is the chat inside the app, because we can see your
          account there.
        </p>
        <ul class="contacts">
          <li>
            <Icon name="chat" />
            <span><strong>Chat in the app</strong><small>Every day, 8am to 8pm</small></span>
          </li>
          {
            company.phone && (
              <li>
                <Icon name="phone" />
                <span>
                  <strong>{company.phone}</strong>
                  <small>Monday to Friday, 8am to 6pm</small>
                </span>
              </li>
            )
          }
          <li>
            <Icon name="document" />
            <span>
              <strong><a href={`mailto:${supportEmail}`}>{supportEmail}</a></strong>
              <small>We reply within one working day</small>
            </span>
          </li>
          <li>
            <Icon name="pin" />
            <span>
              <strong>
                {company.officeAddress ? `${company.officeAddress}, ${company.city}` : company.city}
              </strong>
              <small>Visits by appointment</small>
            </span>
          </li>
        </ul>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>
