---
import Calculator from "../components/Calculator.astro";
import Categories from "../components/Categories.astro";
import Cta from "../components/Cta.astro";
import Icon from "../components/Icon.astro";
import LiveRates from "../components/LiveRates.astro";
import ProductCard from "../components/ProductCard.astro";
import { fallback } from "../data/fallback.ts";
import { billAuction, bondAuction, otherBondTenors } from "../data/market.ts";
import { formatDay, formatMoney, minimumLabel } from "../lib/format.ts";
import Base from "../layouts/Base.astro";

const products = fallback.products;

// What the comparison says about each product beyond its figures. A product with no entry
// here still gets its rate and minimum from the catalogue.
const notes: Record<string, Record<string, string>> = {
  "TREA-91": {
    suits: "Money you will need in about three months",
    more: "Yes, as a new investment",
    interest: "Earned daily, paid at maturity",
    end: "Roll over or pay out",
    early: "Ask in the app, and see the exact amount before you confirm",
    pay: "MTN, Airtel, bank transfer",
  },
  "TREA-182": {
    suits: "Money you can leave for six months",
    more: "Yes, as a new investment",
    interest: "Earned daily, paid at maturity",
    end: "Roll over or pay out",
    early: "Ask in the app, and see the exact amount before you confirm",
    pay: "MTN, Airtel, bank transfer",
  },
  "TREA-364": {
    suits: "Money you can leave for a year",
    more: "Yes, as a new investment",
    interest: "Earned daily, paid at maturity",
    end: "Roll over or pay out",
    early: "Ask in the app, and see the exact amount before you confirm",
    pay: "MTN, Airtel, bank transfer",
  },
  "USD-BOND": {
    suits: "Savings you hold in dollars",
    more: "Yes, any time",
    interest: "Earned daily, paid monthly",
    end: "Stays invested until you withdraw",
    early: "Ask in the app, and see the exact amount before you confirm",
    pay: "Dollar bank transfer",
  },
};

const rows = [
  ["suits", "Who it suits"],
  ["more", "Add more later"],
  ["interest", "Interest"],
  ["end", "At the end"],
  ["early", "Early withdrawal"],
  ["pay", "Pay with"],
] as const;
const note = (code: string, key: string) => notes[code]?.[key] ?? "Ask us";
const listFormat = new Intl.ListFormat("en-GB", { type: "conjunction" });
const others = listFormat.format(otherBondTenors.map(String));
---

<Base
  title="Products and rates"
  description="Uganda Treasury bills at today's rates after tax, the latest Bank of Uganda bill and bond auctions, and the bonds, unit trusts and portfolios coming next."
>
  <section class="band band--black page-title">
    <div class="wrap">
      <p class="eyebrow">Products</p>
      <h1>Simple investments, with the return shown up front.</h1>
      <p>
        Start with Government of Uganda Treasury bills today. Treasury bonds, unit trusts, fixed
        income deposits and thematic equity portfolios are on the way. Every rate is yearly and
        after tax.
      </p>
    </div>
  </section>

  <section class="band band--tight" id="range">
    <div class="wrap">
      <p class="eyebrow">What you can invest in</p>
      <h2 class="h2">Five ways to grow your money.</h2>
      <Categories openHref="#rates" />
    </div>
  </section>

  <section class="band band--flush-top" id="rates">
    <div class="wrap">
      <p class="eyebrow">Open now</p>
      <h2 class="h2">Treasury bills, at today's rates.</h2>
      <p class="lead">
        Our rates follow the Bank of Uganda auction and are updated here whenever they change.
        Last updated <span data-updated>{formatDay(fallback.updatedOn)}</span>.
      </p>
      <div class={`grid ${fallback.products.length > 3 ? "grid--4" : "grid--3"}`}>
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <section class="band band--white" id="auctions">
    <div class="wrap">
      <p class="eyebrow">From the Bank of Uganda</p>
      <h2 class="h2">What the government paid at its latest auctions.</h2>
      <p class="lead">
        These are real Government of Uganda securities. The yields are yearly and after
        withholding tax, the same way we show our own rates.
      </p>

      <h3 class="h3 market-head">Treasury bills, {formatDay(billAuction.heldOn)}</h3>
      <div class="table-box" tabindex="0" role="region" aria-label="Treasury bill auction">
        <table class="compare market">
          <thead>
            <tr>
              <th scope="col">Bill</th>
              <th scope="col">Yield, a year after tax</th>
              <th scope="col">Matures</th>
              <th scope="col">ISIN</th>
              <th scope="col">Accepted</th>
            </tr>
          </thead>
          <tbody>
            {
              billAuction.securities.map((bill) => (
                <tr>
                  <td>{bill.termDays} days</td>
                  <td class="market__yield">{bill.netYieldPercent}%</td>
                  <td>{formatDay(bill.maturesOn)}</td>
                  <td class="market__code">{bill.isin}</td>
                  <td>UGX {bill.acceptedBillions} billion</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="source">Source: {billAuction.source}.</p>

      <h3 class="h3 market-head">Treasury bonds, {formatDay(bondAuction.heldOn)}</h3>
      <div class="table-box" tabindex="0" role="region" aria-label="Treasury bond auction">
        <table class="compare market">
          <thead>
            <tr>
              <th scope="col">Bond</th>
              <th scope="col">Yield to maturity, a year after tax</th>
              <th scope="col">Paid every six months, per UGX 1,000,000</th>
              <th scope="col">Matures</th>
              <th scope="col">ISIN</th>
            </tr>
          </thead>
          <tbody>
            {
              bondAuction.securities.map((bond) => (
                <tr>
                  <td>{bond.years} years</td>
                  <td class="market__yield">{bond.netYieldPercent}%</td>
                  <td>
                    {bond.netCouponPerMillion === null
                      ? "Paid twice a year"
                      : `${formatMoney(bond.netCouponPerMillion, "UGX")} after tax`}
                  </td>
                  <td>{formatDay(bond.maturesOn)}</td>
                  <td class="market__code">{bond.isin}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="source">
        Source: {bondAuction.source}. The Bank of Uganda auctions {others} year bonds in a
        separate round. Treasury bonds are coming soon to Finvest.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Side by side</p>
      <h2 class="h2">Which one fits?</h2>
      <div class="table-box" tabindex="0" role="region" aria-label="Product comparison">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col">Compare</th>
              {products.map((p) => <th scope="col">{p.name}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">{rows[0][1]}</th>
              {products.map((p) => <td>{note(p.code, rows[0][0])}</td>)}
            </tr>
            <tr class="compare__rate">
              <th scope="row">Rate, a year after tax</th>
              {products.map((p) => <td data-rate={p.code}>{p.clientRatePercent}%</td>)}
            </tr>
            <tr>
              <th scope="row">Minimum</th>
              {products.map((p) => <td data-minimum={p.code}>{minimumLabel(p)}</td>)}
            </tr>
            {
              rows.slice(1).map(([key, label]) => (
                <tr>
                  <th scope="row">{label}</th>
                  {products.map((p) => (
                    <td>{note(p.code, key)}</td>
                  ))}
                </tr>
              ))
            }
            <tr>
              <th scope="row">Open to new investments</th>
              {
                products.map((p) => (
                  <td>
                    <span data-when-live={p.code} hidden={p.status !== "live"}>
                      Yes
                    </span>
                    <span data-when-paused={p.code} hidden={p.status !== "paused"}>
                      Coming soon
                    </span>
                  </td>
                ))
              }
            </tr>
            <tr>
              <th scope="row">Fees</th>
              {products.map(() => <td>None to invest. The rate shown is what you earn</td>)}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="band band--white">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Plain words</p>
        <h2 class="h2">What is a treasury bill?</h2>
        <p class="lead">
          It is a short loan to the Government of Uganda. You pay a little less than the face
          value today and the government pays the full value on the maturity date. The difference
          is your interest. Finvest buys the bills for you at Bank of Uganda auctions and shows
          the return as a simple yearly rate after tax.
        </p>
        <h2 class="h2">And a treasury bond?</h2>
        <p class="lead">
          A longer loan to the government, from 2 to 25 years. It pays interest every six months
          and the full amount back at the end. If you sell before then, the price can be higher or
          lower than you paid.
        </p>
      </div>
      <Calculator />
    </div>
  </section>

  <section class="band band--tight">
    <div class="wrap notice">
      <Icon name="shield" size={26} />
      <div>
        <h2>Know the risks</h2>
        <p>
          Held to maturity, a treasury bill pays the amount shown when you invest. Past auction
          yields do not promise future ones, and the next auction can pay more or less. If you withdraw
          early you get back what you put in plus the interest earned so far, with no fee, so you
          earn less than holding to maturity. You see the exact amount before you confirm. Dollar investments also move with the exchange rate if you think in shillings.
          Read the <a href="/legal/risk">risk disclosure</a>.
        </p>
      </div>
    </div>
  </section>

  <Cta />
  <LiveRates />
</Base>
