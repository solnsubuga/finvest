---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page does not exist on the Finvest website.">
  <section class="band band--black">
    <div class="wrap lost">
      <p class="eyebrow">Page not found</p>
      <h1 class="h2">We could not find that page.</h1>
      <p class="lead">The address may be mistyped, or the page may have moved.</p>
      <a class="button button--lime button--large" href="/">Go to the home page</a>
    </div>
  </section>
</Base>
