---
import { draftNotice, layoutOnlyNotice, legalDocuments, versionLabel, type LegalDocument } from "../../data/legal.ts";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return legalDocuments.map((document) => ({
    params: { doc: document.slug },
    props: { document },
  }));
}

interface Props {
  document: LegalDocument;
}

const { document } = Astro.props;
---

<Base
  title={document.title}
  description={document.summary}
  headerTone="light"
>
  <section class="band legal">
    <div class="wrap">
      <p class="eyebrow">Legal</p>
      <h1>{document.title}</h1>
      {document.version ? <p class="legal__version">Version of {versionLabel(document.version)}</p> : null}
      <div class="legal__grid">
        <div class="legal__side">
          <nav class="legal__nav" aria-label="Legal documents">
            {
              legalDocuments.map((item) => (
                <a
                  href={`/legal/${item.slug}`}
                  aria-current={item.slug === document.slug ? "page" : undefined}
                >
                  {item.title}
                </a>
              ))
            }
          </nav>
          <a
            class="button button--outline"
            href={`/legal/${document.slug}.pdf`}
            download={`finvest-${document.slug}.pdf`}
          >
            Download as PDF
          </a>
        </div>
        <article>
          {
            document.stage === "layout" ? (
              <p class="legal__draft">
                <strong>Layout only.</strong> {layoutOnlyNotice}
              </p>
            ) : document.stage === "draft" ? (
              <p class="legal__draft">
                <strong>Draft for legal review.</strong> {draftNotice}
              </p>
            ) : null
          }
          {
            document.sections.map((section, index) => (
              <section class="legal__section">
                <h2>
                  {index + 1}. {section.heading}
                </h2>
                {section.body.map((block) =>
                  typeof block === "string" ? (
                    <p>{block}</p>
                  ) : (
                    <ul>
                      {block.list.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  ),
                )}
              </section>
            ))
          }
        </article>
      </div>
    </div>
  </section>
</Base>

